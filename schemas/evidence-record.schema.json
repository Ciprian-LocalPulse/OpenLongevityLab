{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlongevity.example/schemas/evidence-record.schema.json",
  "title": "OpenLongevity Evidence Record",
  "type": "object",
  "required": ["identifier", "title", "study_type", "species", "endpoint", "source"],
  "properties": {
    "identifier": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "study_type": {"enum": ["systematic_review", "randomized_controlled_trial", "clinical", "observational", "animal", "in_vitro", "computational"]},
    "species": {"type": "string"},
    "endpoint": {"type": "string"},
    "source": {"type": "string", "minLength": 1},
    "publication_date": {"type": ["string", "null"], "format": "date"},
    "sample_size": {"type": ["integer", "null"], "minimum": 0},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "replication_status": {"type": "string"},
    "retraction_status": {"enum": ["active", "corrected", "expression_of_concern", "retracted", "unknown"]},
    "tags": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
